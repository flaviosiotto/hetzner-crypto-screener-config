# Percorsi sorgenti
SI8CLOUD_BE_SRC_DIR=../si8cloud-backend
SI8CLOUD_FE_SRC_DIR=../si8cloud-frontend

# Database PostgreSQL
SI8CLOUD_POSTGRES_DB=postgres
SI8CLOUD_POSTGRES_USER=postgres
SI8CLOUD_POSTGRES_PASSWORD=postgres
